{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/structured-result.schema.json",
  "title": "Parser structured result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "extracted", "entities"],
  "properties": {
    "schemaId": {
      "type": "string",
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "extracted": {
      "type": "object",
      "maxProperties": 1024
    },
    "entities": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/EntityObservation" }
    }
  },
  "$defs": {
    "EntityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifiers", "attributes"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "identifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/EntityIdentifier" }
        },
        "attributes": {
          "type": "object",
          "maxProperties": 256
        }
      }
    },
    "EntityIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["ad_sid", "mac", "fqdn", "hostname", "ip", "other"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
