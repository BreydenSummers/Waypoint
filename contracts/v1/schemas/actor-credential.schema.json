{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/actor-credential.schema.json",
  "title": "One-time actor credential response",
  "description": "Returned once by provisioning or rotation. The plaintext token is never available from a later read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "actorRecord", "token", "issuedAt"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "actorRecord": { "$ref": "actor-record.schema.json" },
    "token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9._~-]+$", "writeOnly": true },
    "issuedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
