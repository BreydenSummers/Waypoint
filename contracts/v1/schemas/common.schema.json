{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/common.schema.json",
  "title": "Waypoint v1 common contract types",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ContractVersion": {
      "const": "1.0.0"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Cursor": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "x-waypoint-maximum": "9223372036854775807"
    },
    "RequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "IpAddress": {
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "format": "ipv6" }
      ]
    },
    "NonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasMore"],
      "properties": {
        "nextCursor": { "$ref": "#/$defs/Cursor" },
        "hasMore": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "hasMore": { "const": true } }, "required": ["hasMore"] },
          "then": { "required": ["nextCursor"] }
        }
      ]
    },
    "SafeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\x00]+$"
    }
  }
}
