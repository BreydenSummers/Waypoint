{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/report-snapshot.schema.json",
  "title": "Frozen authoritative report input",
  "description": "Versioned immutable report input generated from the export snapshot, never from browser fixtures or changing live queries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "exportJobId", "engagement", "cutoff", "scope", "methodology", "findings", "actions", "knownCaptureGaps", "generatedAt"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/ContractVersion" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "exportJobId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "client"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "client": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "cutoff": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "scope": { "type": "array", "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "methodology": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "status", "affectedEntityIds", "evidenceActionIds", "remediation", "promotedBy", "promotedAt"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
          "status": { "enum": ["draft", "confirmed", "resolved", "accepted_risk"] },
          "affectedEntityIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Uuid" } },
          "evidenceActionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Uuid" } },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 65536 },
          "promotedBy": { "$ref": "actor.schema.json" },
          "promotedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
        }
      }
    },
    "actions": { "type": "array", "maxItems": 100000, "items": { "$ref": "action.schema.json" } },
    "knownCaptureGaps": { "type": "array", "maxItems": 10000, "items": { "$ref": "out-of-band-claim.schema.json" } },
    "generatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
