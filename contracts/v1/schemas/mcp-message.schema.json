{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/mcp-message.schema.json",
  "title": "Waypoint MCP JSON-RPC message",
  "description": "MCP Streamable HTTP messages for protocol revision 2025-03-26 and the closed v1 capture/status tool inventory.",
  "oneOf": [
    { "$ref": "#/$defs/InitializeRequest" },
    { "$ref": "#/$defs/InitializedNotification" },
    { "$ref": "#/$defs/ToolsListRequest" },
    { "$ref": "#/$defs/ToolCallRequest" },
    { "$ref": "#/$defs/SuccessResponse" },
    { "$ref": "#/$defs/ErrorResponse" }
  ],
  "$defs": {
    "JsonRpcId": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }] },
    "InitializeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/JsonRpcId" }, "method": { "const": "initialize" },
        "params": {
          "type": "object", "additionalProperties": false,
          "required": ["protocolVersion", "capabilities", "clientInfo"],
          "properties": {
            "protocolVersion": { "const": "2025-03-26" },
            "capabilities": { "type": "object", "maxProperties": 32 },
            "clientInfo": { "$ref": "#/$defs/Implementation" }
          }
        }
      }
    },
    "InitializedNotification": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "method"],
      "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "notifications/initialized" }, "params": { "type": "object", "maxProperties": 0 } }
    },
    "ToolsListRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/JsonRpcId" }, "method": { "const": "tools/list" }, "params": { "type": "object", "additionalProperties": false } }
    },
    "ToolCallRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/JsonRpcId" }, "method": { "const": "tools/call" },
        "params": {
          "type": "object", "additionalProperties": false, "required": ["name", "arguments"],
          "properties": {
            "name": { "enum": ["waypoint_ingest_capture", "waypoint_capture_status"] },
            "arguments": { "type": "object" }
          }
        }
      }
    },
    "Implementation": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "SuccessResponse": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/JsonRpcId" }, "result": { "type": "object" } }
    },
    "ErrorResponse": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" }, "id": { "oneOf": [{ "$ref": "#/$defs/JsonRpcId" }, { "type": "null" }] },
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "enum": [-32700, -32600, -32601, -32602, -32603] },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "data": { "type": "object" }
          }
        }
      }
    },
    "IngestCaptureArguments": {
      "type": "object", "additionalProperties": false,
      "required": ["idempotencyKey", "envelope", "stdoutBase64", "stderrBase64"],
      "properties": {
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/Uuid" },
        "envelope": { "$ref": "capture-envelope.schema.json" },
        "stdoutBase64": { "type": "string", "contentEncoding": "base64" },
        "stderrBase64": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "CaptureStatusArguments": {
      "type": "object", "additionalProperties": false, "required": ["captureId", "sourceAgentId"],
      "properties": { "captureId": { "$ref": "common.schema.json#/$defs/Uuid" }, "sourceAgentId": { "$ref": "common.schema.json#/$defs/Uuid" } }
    },
    "ToolCallResult": {
      "type": "object", "additionalProperties": false, "required": ["content", "isError", "structuredContent"],
      "properties": {
        "content": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
        "isError": { "type": "boolean" },
        "structuredContent": { "type": "object" }
      }
    }
  }
}
