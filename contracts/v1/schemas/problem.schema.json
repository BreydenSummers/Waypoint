{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waypoint.security/contracts/v1/problem.schema.json",
  "title": "Waypoint API problem detail",
  "description": "RFC 9457 problem detail with stable machine fields. detail and field messages are safe summaries and never echo tokens or raw evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "code", "requestId", "retryable"],
  "properties": {
    "type": { "type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 512 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "instance": { "type": "string", "format": "uri-reference", "maxLength": 512 },
    "code": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "forbidden",
        "unsupported_contract_version",
        "idempotency_conflict",
        "evidence_integrity_mismatch",
        "payload_too_large",
        "rate_limited",
        "cursor_invalid",
        "cursor_mismatch",
        "cursor_expired",
        "service_unavailable",
        "internal_error"
      ]
    },
    "requestId": { "$ref": "common.schema.json#/$defs/RequestId" },
    "retryable": { "type": "boolean" },
    "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "fieldErrors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointer", "code", "message"],
        "properties": {
          "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 2048 },
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "existingActionId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "minimumAvailableCursor": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Cursor" },
        { "type": "null" }
      ]
    },
    "resync": { "type": "string", "format": "uri-reference", "maxLength": 512 },
    "supportedVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "code": { "enum": ["invalid_request", "cursor_invalid", "cursor_mismatch"] } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 400 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "unauthenticated" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 401 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "forbidden" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 403 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "idempotency_conflict" } }, "required": ["code"] },
      "then": { "required": ["existingActionId"], "properties": { "status": { "const": 409 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "cursor_expired" } }, "required": ["code"] },
      "then": { "required": ["minimumAvailableCursor", "resync"], "properties": { "status": { "const": 410 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "payload_too_large" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 413 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "evidence_integrity_mismatch" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 422 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "unsupported_contract_version" } }, "required": ["code"] },
      "then": { "required": ["supportedVersions"], "properties": { "status": { "const": 426 }, "retryable": { "const": false } } }
    },
    {
      "if": { "properties": { "code": { "const": "rate_limited" } }, "required": ["code"] },
      "then": { "required": ["retryAfterSeconds"], "properties": { "status": { "const": 429 }, "retryable": { "const": true } } }
    },
    {
      "if": { "properties": { "code": { "const": "internal_error" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 500 }, "retryable": { "const": true } } }
    },
    {
      "if": { "properties": { "code": { "const": "service_unavailable" } }, "required": ["code"] },
      "then": { "properties": { "status": { "const": 503 }, "retryable": { "const": true } } }
    }
  ]
}
